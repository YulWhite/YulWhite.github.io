---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="404">
  <section class="home-title">
    <h1>404</h1>
    <span>这个页面不见了</span>
  </section>
  <p style="text-align:center; padding-bottom:3em;">
    <a href={`${base}/`}>← 回首页</a>
  </p>
</Base>
