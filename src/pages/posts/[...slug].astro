---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <h1 class="post-title">{post.data.title}</h1>
    <div class="post-meta">
      <time class="date">{fmt(post.data.date)}</time>
      <span class="category">{post.data.category}</span>
      {post.data.tags.map((tag) => <span class="tags">{tag}</span>)}
    </div>
    <div class="post-content">
      <Content />
    </div>
    <p class="back"><a href={`${base}/`}>← 返回首页</a></p>
  </article>
</Base>

<style>
  .post { padding: 1em 0 3em; }
  .post-title { margin-bottom: .4em; }
  .post :global(.post-title)::before { content: none; }
  .post-content { line-height: 1.9; }
  .post-content :global(h2) { margin-top: 1.6em; font-size: 1.15em; color: #4a7fd4; }
  .post-content :global(code) { background: rgba(0,0,0,.05); padding: .1em .35em; border-radius: 4px; }
  .post-content :global(pre) { padding: 1em; overflow: auto; border-radius: 10px; background: #1f2328; color: #e8e8e8; }
  .post-content :global(pre code) { background: transparent; padding: 0; color: inherit; }
  .back { margin-top: 2.5em; }
</style>
