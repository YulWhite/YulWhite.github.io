---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categories } from '../../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getCollection('posts', ({ data }) => !data.draft);
const counts = Object.fromEntries(
  categories.map((category) => [category.name, posts.filter((post) => post.data.category === category.name).length]),
);
---
<Base title="分类" description="按分类浏览文章">
  <section class="home-title">
    <h1>分类</h1>
    <span>共 {categories.length} 个分类</span>
  </section>

  <div class="category-list">
    {categories.map((category) => (
      <a class="category-card" href={`${base}/categories/${category.slug}/`}>
        <h2>{category.name}</h2>
        <p>{category.description}</p>
        <span>{counts[category.name]} 篇</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .category-list {
    display: grid;
    gap: 1em;
    padding-bottom: 3em;
  }
  .category-card {
    display: block;
    padding: 1.1em 1.4em;
    border: 1px solid rgba(0, 0, 0, .06);
    border-radius: 14px;
    background: rgba(255, 255, 255, .55);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .category-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(72, 96, 128, .12);
  }
  .category-card h2 {
    margin: 0;
    font-size: 1.1em;
    color: #4a7fd4;
  }
  .category-card p {
    margin: .35em 0 0;
    color: #5b6673;
    font-size: .9em;
  }
  .category-card span {
    display: inline-block;
    margin-top: .6em;
    color: #97a1ae;
    font-size: .8em;
  }
</style>
