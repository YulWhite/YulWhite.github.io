---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---
<Base>
  <section class="home-title">
    <h1>“白榆”</h1>
    <span>记录建站、学习和一些没想清楚的事</span>
  </section>

  <section class="home-posts">
    {posts.map((post) => (
      <div class="post-item">
        <h2><a href={`${base}/posts/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div class="post-meta">
          <time class="date">{fmt(post.data.date)}</time>
          <span class="category">{post.data.category}</span>
          {post.data.tags.map((tag) => <span class="tags">{tag}</span>)}
        </div>
      </div>
    ))}
    {posts.length === 0 && <p>还没有文章，去 <code>src/content/posts/</code> 里新建一篇吧。</p>}
  </section>
</Base>
