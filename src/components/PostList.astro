---
import { categoryUrl } from '../data/categories';
import { fmtDate } from '../utils/date';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { posts } = Astro.props;
---
{posts.map((post) => (
  <div class="post-item">
    <h2><a href={`${base}/posts/${post.id}/`}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-meta">
      <time class="date">{fmtDate(post.data.date)}</time>
      <span class="category">
        <a href={`${base}${categoryUrl(post.data.category)}`}>{post.data.category}</a>
      </span>
      {post.data.tags.map((tag) => <span class="tags">{tag}</span>)}
    </div>
  </div>
))}
